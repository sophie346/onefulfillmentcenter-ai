# Public site origin (canonical / OG / sitemap / robots)
NEXT_PUBLIC_SITE_URL=https://onefulfillcenter.com

# oneauto SEO BFF (same APIs as Nexus: websiteseodata / pageseodata)
NEXT_PUBLIC_SEO_API_BASE_URL=https://backend.oneauto.us

# Must match the B2B website `label` in admin SEO settings
NEXT_PUBLIC_WEBSITE_LABEL=onefulfillcenter

# oneauto `clientname` header
NEXT_PUBLIC_CLIENT_NAME=oneauto
